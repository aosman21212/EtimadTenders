<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etimad_activity_tree" model="ir.ui.view">
        <field name="name">etimad.activity.tree</field>
        <field name="model">etimad.activity</field>
        <field name="arch" type="xml">
            <tree string="Activities / Sectors" editable="bottom">
                <field name="name"/>
                <field name="ext_id"/>
            </tree>
        </field>
    </record>

    <record id="action_etimad_activity" model="ir.actions.act_window">
        <field name="name">Activities / Sectors</field>
        <field name="res_model">etimad.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_etimad_activity_sync" model="ir.actions.server">
        <field name="name">Sync Activities from Etimad</field>
        <field name="model_id" ref="model_etimad_activity"/>
        <field name="binding_model_id" ref="model_etimad_activity"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.sync_from_api()</field>
    </record>

    <menuitem id="menu_etimad_tenders_config" name="Configuration" parent="menu_etimad_tenders_root"
              sequence="90" groups="etimad_tenders.group_etimad_tender_manager"/>
    <menuitem id="menu_etimad_tenders_activities" name="Activities / Sectors" parent="menu_etimad_tenders_config"
              action="action_etimad_activity" sequence="10"/>

</odoo>
