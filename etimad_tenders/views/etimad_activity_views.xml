<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ─────────────────────────────────────────────────── -->
    <record id="view_etimad_activity_list" model="ir.ui.view">
        <field name="name">etimad.activity.list</field>
        <field name="model">etimad.activity</field>
        <field name="arch" type="xml">
            <list string="Etimad Activity Sectors">
                <field name="activity_id_external" string="ID"/>
                <field name="name_en"  string="English Label"/>
                <field name="name"     string="Arabic Name"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────────── -->
    <record id="view_etimad_activity_form" model="ir.ui.view">
        <field name="name">etimad.activity.form</field>
        <field name="model">etimad.activity</field>
        <field name="arch" type="xml">
            <form string="Etimad Activity Sector">
                <sheet>
                    <div class="oe_title">
                        <label for="display_name"/>
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="activity_id_external"/>
                        <field name="name"/>
                        <field name="name_en"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_etimad_activity" model="ir.actions.act_window">
        <field name="name">Activity Sectors</field>
        <field name="res_model">etimad.activity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity sectors yet!</p>
            <p>
                Go to <strong>Configuration</strong> and click
                <strong>Sync Sectors from Etimad</strong> to populate this list.
            </p>
        </field>
    </record>

</odoo>
